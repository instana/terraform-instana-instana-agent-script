#!/bin/bash
#
# Instana Agent Bootstrap Script
# Generated by the terraform-instana-agent-script module.
# Works on Debian/Ubuntu (apt) and Amazon Linux / RHEL (yum/dnf).
#
set -e
set -o pipefail

# ==============================================================================
# Configuration — injected at Terraform render time
# ==============================================================================

INSTANA_AGENT_KEY="${instana_agent_key}"
INSTANA_DOWNLOAD_KEY="${instana_download_key}"
INSTANA_ENDPOINT_HOST="${instana_endpoint_host}"
INSTANA_ENDPOINT_PORT="${instana_endpoint_port}"
INSTANA_AGENT_MODE="${instana_agent_mode}"
AGENT_MAX_MEM="${agent_max_memory}M"

LOG_FILE="/var/log/instana-agent-install.log"
SETUP_SCRIPT="/tmp/setup_agent.sh"

# ==============================================================================
# Logging helpers
# ==============================================================================

log() {
    echo "[$(date +'%Y-%m-%d %H:%M:%S')] $*" | tee -a "$LOG_FILE"
}

error_exit() {
    log "ERROR: $1"
    exit 1
}

# Redirect all output to log file from this point on
exec > >(tee -a "$LOG_FILE")
exec 2>&1

log "========================================="
log "Instana Agent Installation Starting"
log "========================================="
log "  Endpoint : $INSTANA_ENDPOINT_HOST:$INSTANA_ENDPOINT_PORT"
log "  Mode     : $INSTANA_AGENT_MODE"
log "  Max Mem  : $AGENT_MAX_MEM"

# ==============================================================================
# Validate credentials
# ==============================================================================

[ -z "$INSTANA_AGENT_KEY" ]    && error_exit "instana_agent_key is empty. Check your Terraform configuration."
[ -z "$INSTANA_DOWNLOAD_KEY" ] && error_exit "instana_download_key is empty. Check your Terraform configuration."

log "✓ Credentials validated"

# ==============================================================================
# Detect package manager and install prerequisites
# ==============================================================================

if command -v apt-get &>/dev/null; then
    PKG_MGR="apt"
elif command -v yum &>/dev/null; then
    PKG_MGR="yum"
else
    error_exit "No supported package manager found (apt-get or yum required)."
fi

log "Detected package manager: $PKG_MGR"

if [ "$PKG_MGR" = "apt" ]; then
    log "Performing cleanup of any previous Instana installation..."
    systemctl stop instana-agent 2>/dev/null || true
    apt-get remove --purge -y instana-agent-* 2>/dev/null || true
    rm -rf /opt/instana /var/lib/instana
    rm -f /etc/apt/sources.list.d/instana-*.list
    rm -f /etc/apt/auth.conf.d/instana-*.conf
    rm -f /usr/share/keyrings/instana-*.gpg
    apt-get autoremove -y 2>/dev/null || true
    apt-get clean
    log "✓ Cleanup completed"

    log "Installing prerequisites (apt)..."
    apt-get update -qq             || error_exit "Failed to update package lists"
    apt-get install -y -qq curl apt-transport-https ca-certificates \
        || error_exit "Failed to install prerequisites"
else
    log "Performing cleanup of any previous Instana installation..."
    systemctl stop instana-agent 2>/dev/null || true
    yum remove -y instana-agent 2>/dev/null || true
    rm -rf /opt/instana /var/lib/instana
    rm -f /etc/yum.repos.d/instana-*.repo
    log "✓ Cleanup completed"

    log "Installing prerequisites (yum)..."
    yum install -y curl ca-certificates || error_exit "Failed to install prerequisites"
fi

log "✓ Prerequisites installed"

# ==============================================================================
# Download and run the official Instana setup script
# ==============================================================================

log "Downloading Instana agent setup script..."
curl -fsSo "$SETUP_SCRIPT" https://setup.instana.io/agent \
    || error_exit "Failed to download Instana setup script from https://setup.instana.io/agent"
chmod 700 "$SETUP_SCRIPT"
log "✓ Setup script downloaded"

INSTANA_ENDPOINT="$INSTANA_ENDPOINT_HOST:$INSTANA_ENDPOINT_PORT"
log "Installing Instana agent (endpoint: $INSTANA_ENDPOINT)..."

export AGENT_MAX_MEM

"$SETUP_SCRIPT" \
    -a "$INSTANA_AGENT_KEY" \
    -d "$INSTANA_DOWNLOAD_KEY" \
    -t "$INSTANA_AGENT_MODE" \
    -e "$INSTANA_ENDPOINT" \
    -s \
    -y \
    || error_exit "Instana agent installation failed. Check the logs above for details."

log "✓ Instana agent installed successfully"

# ==============================================================================
# Append custom configuration (if provided)
# ==============================================================================
%{ if custom_config_yaml_base64 != "" }
log "Appending custom configuration to configuration.yaml..."

CONFIG_FILE="/opt/instana/agent/etc/instana/configuration.yaml"

# Backup existing config
cp "$CONFIG_FILE" "$${CONFIG_FILE}.backup.$(date +%s)"
log "✓ Configuration backup created"

# Decode and append
printf '\n# Custom configuration (added by Terraform)\n' >> "$CONFIG_FILE"
printf '%s' "${custom_config_yaml_base64}" | base64 -d >> "$CONFIG_FILE"

log "✓ Custom configuration appended"
%{ endif }

# ==============================================================================
# Verify agent is running
# ==============================================================================

log "Verifying agent status..."
if systemctl is-active --quiet instana-agent; then
    log "✓ Instana agent is running"
    systemctl status instana-agent --no-pager | tee -a "$LOG_FILE"
else
    systemctl status instana-agent --no-pager | tee -a "$LOG_FILE" || true
    error_exit "Agent failed to start. Run: sudo systemctl status instana-agent"
fi

# ==============================================================================
# Cleanup
# ==============================================================================

rm -f "$SETUP_SCRIPT"

# Clear sensitive variables from memory
unset INSTANA_AGENT_KEY
unset INSTANA_DOWNLOAD_KEY

log "========================================="
log "Instana Agent Installation Complete"
log "========================================="
log "Endpoint : $INSTANA_ENDPOINT"
log "Mode     : $INSTANA_AGENT_MODE"
log ""
log "Check status : sudo systemctl status instana-agent"
log "Agent logs   : sudo tail -f /opt/instana/agent/data/log/agent.log"
log "Install log  : $LOG_FILE"

exit 0
