#Requires -RunAsAdministrator
<powershell>
# ==============================================================================
# Instana Agent Bootstrap Script — Windows
# Generated by the terraform-instana-agent-script module.
# Tested on: Windows Server 2019 / 2022 and Windows 10/11 (64-bit).
# ==============================================================================

Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'

# ==============================================================================
# Configuration — injected at Terraform render time
# ==============================================================================

$InstanaAgentKey     = '${instana_agent_key}'
$InstanaDownloadKey  = '${instana_download_key}'
$InstanaEndpointHost = '${instana_endpoint_host}'
$InstanaEndpointPort = ${instana_endpoint_port}
$InstanaAgentMode    = '${instana_agent_mode}'
$AgentMaxMemoryMB    = ${agent_max_memory}

$LogFile   = 'C:\instana-agent-install.log'
$SetupExe  = "$env:TEMP\instana-agent-setup.exe"

# ==============================================================================
# Logging helpers
# ==============================================================================

function Write-Log {
    param([string]$Message)
    $ts = Get-Date -Format 'yyyy-MM-dd HH:mm:ss'
    $line = "[$ts] $Message"
    Write-Output $line
    Add-Content -Path $LogFile -Value $line
}

function Exit-WithError {
    param([string]$Message)
    Write-Log "ERROR: $Message"
    exit 1
}

# ==============================================================================
# Bootstrap
# ==============================================================================

Write-Log '========================================='
Write-Log 'Instana Agent Installation Starting'
Write-Log '========================================='
Write-Log "  Endpoint : $InstanaEndpointHost`:$InstanaEndpointPort"
Write-Log "  Mode     : $InstanaAgentMode"
Write-Log "  Max Mem  : $($AgentMaxMemoryMB)MB"

# Validate credentials
if ([string]::IsNullOrEmpty($InstanaAgentKey))    { Exit-WithError 'instana_agent_key is empty. Check your Terraform configuration.' }
if ([string]::IsNullOrEmpty($InstanaDownloadKey)) { Exit-WithError 'instana_download_key is empty. Check your Terraform configuration.' }

Write-Log '✓ Credentials validated'

# ==============================================================================
# Stop and remove any existing Instana agent installation
# ==============================================================================

Write-Log 'Checking for existing Instana agent installation...'
$svc = Get-Service -Name 'instana-agent' -ErrorAction SilentlyContinue
if ($svc) {
    Write-Log 'Stopping existing instana-agent service...'
    Stop-Service -Name 'instana-agent' -Force -ErrorAction SilentlyContinue
    Start-Sleep -Seconds 5
}

$agentDir = 'C:\instana'
if (Test-Path $agentDir) {
    Write-Log "Removing existing agent directory: $agentDir"
    Remove-Item -Path $agentDir -Recurse -Force -ErrorAction SilentlyContinue
}
Write-Log '✓ Cleanup completed'

# ==============================================================================
# Download the official Instana Windows installer
# ==============================================================================

Write-Log 'Downloading Instana agent setup executable...'
$downloadUrl = "https://artifact-public.instana.io/artifactory/shared/com/instana/agent-dynamic/$InstanaDownloadKey/windows/instana-agent-setup.exe"

try {
    [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
    $wc = New-Object System.Net.WebClient
    $wc.Headers.Add('Authorization', "Bearer $InstanaDownloadKey")
    $wc.DownloadFile($downloadUrl, $SetupExe)
} catch {
    Exit-WithError "Failed to download Instana agent installer: $_"
}

if (-not (Test-Path $SetupExe)) {
    Exit-WithError "Installer file not found after download: $SetupExe"
}
Write-Log '✓ Installer downloaded'

# ==============================================================================
# Run the silent installer
# ==============================================================================

$InstanaEndpoint = "$InstanaEndpointHost`:$InstanaEndpointPort"
Write-Log "Installing Instana agent (endpoint: $InstanaEndpoint)..."

$installArgs = @(
    '/S',                                          # Silent install
    "/AGENT_KEY=$InstanaAgentKey",
    "/DOWNLOAD_KEY=$InstanaDownloadKey",
    "/ENDPOINT_HOST=$InstanaEndpointHost",
    "/ENDPOINT_PORT=$InstanaEndpointPort",
    "/AGENT_MODE=$InstanaAgentMode",
    "/AGENT_MAX_MEMORY=$($AgentMaxMemoryMB)m"
)

try {
    $proc = Start-Process -FilePath $SetupExe -ArgumentList $installArgs -Wait -PassThru
    if ($proc.ExitCode -ne 0) {
        Exit-WithError "Installer exited with code $($proc.ExitCode). Check logs at $LogFile"
    }
} catch {
    Exit-WithError "Failed to run Instana agent installer: $_"
}

Write-Log '✓ Instana agent installed successfully'

# ==============================================================================
# Append custom configuration (if provided)
# ==============================================================================
%{ if custom_config_yaml_base64 != "" }
Write-Log 'Appending custom configuration to configuration.yaml...'

$configFile = 'C:\instana\agent\etc\instana\configuration.yaml'

if (-not (Test-Path $configFile)) {
    Exit-WithError "configuration.yaml not found at: $configFile"
}

# Backup existing config
$backupFile = "$configFile.backup.$([DateTimeOffset]::UtcNow.ToUnixTimeSeconds())"
Copy-Item -Path $configFile -Destination $backupFile
Write-Log "✓ Configuration backup created: $backupFile"

# Decode and append
$customYamlB64  = '${custom_config_yaml_base64}'
$customYamlBytes = [System.Convert]::FromBase64String($customYamlB64)
$customYaml      = [System.Text.Encoding]::UTF8.GetString($customYamlBytes)

Add-Content -Path $configFile -Value "`n# Custom configuration (added by Terraform)`n$customYaml"
Write-Log '✓ Custom configuration appended'
%{ endif }

# ==============================================================================
# Start / verify service
# ==============================================================================

Write-Log 'Starting instana-agent service...'
Start-Sleep -Seconds 10

try {
    Start-Service -Name 'instana-agent' -ErrorAction Stop
} catch {
    Write-Log "Warning: could not explicitly start service (may auto-start): $_"
}

Start-Sleep -Seconds 15

$svc = Get-Service -Name 'instana-agent' -ErrorAction SilentlyContinue
if ($svc -and $svc.Status -eq 'Running') {
    Write-Log '✓ Instana agent is running'
} else {
    $status = if ($svc) { $svc.Status } else { 'not found' }
    Exit-WithError "Agent service status: $status. Run: Get-Service instana-agent"
}

# ==============================================================================
# Cleanup
# ==============================================================================

Remove-Item -Path $SetupExe -Force -ErrorAction SilentlyContinue

# Clear sensitive variables from memory
$InstanaAgentKey    = $null
$InstanaDownloadKey = $null
[System.GC]::Collect()

Write-Log '========================================='
Write-Log 'Instana Agent Installation Complete'
Write-Log '========================================='
Write-Log "Endpoint : $InstanaEndpoint"
Write-Log "Mode     : $InstanaAgentMode"
Write-Log ''
Write-Log 'Check status : Get-Service instana-agent'
Write-Log 'Agent logs   : C:\instana\agent\data\log\agent.log'
Write-Log "Install log  : $LogFile"
</powershell>
